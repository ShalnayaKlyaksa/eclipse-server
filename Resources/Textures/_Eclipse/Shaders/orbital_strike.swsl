light_mode unshaded;

uniform highp vec2 center;
uniform highp vec2 pixel_scale;
uniform highp float radius;
uniform highp float age;
uniform highp float seed;
uniform highp float kinetic;
uniform highp float motion;

highp float hash(highp vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

highp float noise(highp vec2 p) {
    highp vec2 i = floor(p);
    highp vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
        mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0)), f.x), f.y);
}

void fragment() {
    highp vec2 q = (FRAGCOORD.xy - center) / max(pixel_scale * radius, vec2(0.01));
    highp float r = length(q);
    highp float t = max(0.0, age);
    highp float expansion = mix(0.52, min(0.82, 0.12 + t * 0.6), motion);
    highp vec2 flow = q * 7.0 / max(0.15, expansion) + vec2(seed, t * motion * 0.65);
    highp float turbulence = noise(flow) * 0.6 + noise(flow * 2.13) * 0.28 + noise(flow * 4.7) * 0.12;
    highp float cloud = (1.0 - smoothstep(expansion * 0.15, expansion, r)) *
        smoothstep(0.18, 0.7, turbulence) * min(1.0, t * 5.0) * exp(-t * 0.8);
    highp float fire = exp(-r * r / max(0.004, 0.075 + t * 0.13)) * exp(-t * 4.7);
    highp float ringRadius = mix(0.48, min(0.95, 0.09 + t * 1.4), motion);
    highp float shock = exp(-pow((r - ringRadius) / 0.014, 2.0)) * exp(-t * 3.5);
    highp float core = exp(-r * r * 320.0) * exp(-t * 12.0);
    highp vec3 hot = mix(vec3(1.0, 0.36, 0.06), vec3(0.55, 0.83, 1.0), kinetic);
    highp vec3 dust = mix(vec3(0.22, 0.19, 0.16), vec3(0.16, 0.2, 0.24), kinetic);
    highp float opacity = clamp(cloud * 0.65 + fire * 0.8 + shock * 0.6 + core, 0.0, 0.92);
    highp vec3 color = dust * cloud * 0.65 + hot * fire * 0.8 + vec3(0.9, 0.94, 1.0) * (shock * 0.6 + core);
    highp float edge = 1.0 - smoothstep(0.9, 1.0, r);
    COLOR = vec4(clamp(color / max(0.001, opacity), 0.0, 1.0), opacity * edge);
}

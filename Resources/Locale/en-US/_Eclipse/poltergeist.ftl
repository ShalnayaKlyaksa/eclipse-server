roles-antag-poltergeist-name = Poltergeist
roles-antag-poltergeist-objective = Haunt objects, frighten the crew and avoid exorcism.
ghost-role-information-poltergeist-description = A restless spirit. Possess objects, speak as them, move them and knock to frighten the crew. A spectral detector can seal you inside an object so the crew can exorcise you.
guide-entry-poltergeist = Poltergeist
poltergeist-possessed = You are now haunting { $target }. Use normal chat to speak and the Move object action to move.
poltergeist-knock = An eerie knocking comes from inside { $target }!
poltergeist-scan-found = Spectral activity detected: { $count }. Examine nearby objects.
poltergeist-scan-clear = No spectral activity detected.
poltergeist-sealed = A spectral seal traps the spirit inside { $target } for 12 seconds!
poltergeist-exorcise-verb = Exorcise poltergeist
poltergeist-exorcised = The spirit has been exorcised from { $target }!
poltergeist-examine-haunted = [color=mediumpurple]The object feels cold. Something is watching from inside.[/color]
poltergeist-examine-sealed = [color=cyan]A poltergeist is sealed inside. The seal will soon expire — begin the exorcism![/color]
poltergeist-energy = Spectral activity: { $energy } / { $max }.
poltergeist-blocked-sealed = The spectral seal prevents you from acting or leaving your vessel!
poltergeist-cannot-possess = You cannot possess that now. Choose a nearby unoccupied object.
poltergeist-no-energy = Not enough spectral activity. Wait for it to recover.
terror-poltergeist = Attention! Anomalous spectral activity has been detected aboard the station.

<pda:PdaSettingsButton xmlns="https://spacestation14.io"
                       xmlns:pda="clr-namespace:Content.Client.PDA"
                       HorizontalExpand="True"
                       MinHeight="36"
                       Margin="0">
<PanelContainer Name="Panel"/>
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" Margin="8 4" SeparationOverride="1">
        <Label Name="OptionName" ClipText="True" StyleClasses="pda-caption"/>
        <Label Name="OptionDescription" ClipText="True" StyleClasses="terminal-muted"/>
    </BoxContainer>
</pda:PdaSettingsButton>

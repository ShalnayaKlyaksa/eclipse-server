<controls:ImmersiveFancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    MinSize="540 360" SetSize="620 450" Title="{Loc 'portable-generator-ui-title'}">
    <ScrollContainer Name="GeneratorScroll" HScrollEnabled="False" ReserveScrollbarSpace="True">
        <BoxContainer Margin="12 10" Orientation="Vertical" SeparationOverride="12">
            <BoxContainer SeparationOverride="12">
                <SpriteView Name="EntityView" SetSize="64 64" Scale="2 2" OverrideDirection="South"/>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                    <Label Name="PlantName" StyleClasses="terminal-heading" ClipText="True"/>
                    <Label Name="StatusLabel" StyleClasses="terminal-muted"/>
                    <Label Name="NetworkStats" StyleClasses="terminal-muted" ClipText="True"/>
                </BoxContainer>
                <BoxContainer MinWidth="140" Orientation="Vertical" VerticalAlignment="Center">
                    <Button Name="StartButton" Visible="False" Text="{Loc 'portable-generator-ui-start'}"/>
                    <Button Name="StopButton" Visible="False" Text="{Loc 'portable-generator-ui-stop'}"/>
                    <ProgressBar Name="StartProgress" Visible="False" MaxValue="1"/>
                    <Label Name="LabelUnanchored" Visible="False" Text="{Loc 'portable-generator-ui-unanchored'}"/>
                </BoxContainer>
            </BoxContainer>

            <BoxContainer Name="GeneratorSettings" Orientation="Vertical" SeparationOverride="7">
                <BoxContainer SeparationOverride="8">
                    <Label Name="TargetLabel" MinWidth="240" Text="{Loc 'portable-generator-ui-target-power-label'}"/>
                    <SpinBox Name="TargetPower" HorizontalExpand="True"/>
                    <BoxContainer Name="FusionModes" Visible="False" HorizontalExpand="True" SeparationOverride="8">
                        <Button Name="FusionNominal" Text="{Loc 'power-fusion-nominal'}" HorizontalExpand="True"/>
                        <Button Name="FusionBoost" Text="{Loc 'power-fusion-boost'}" HorizontalExpand="True"/>
                    </BoxContainer>
                </BoxContainer>
                <BoxContainer SeparationOverride="8">
                    <Label MinWidth="240" Text="{Loc 'power-plant-fuel-economy'}"/>
                    <Label Name="Efficiency"/>
                    <Label Name="Eta"/>
                </BoxContainer>
                <BoxContainer SeparationOverride="8">
                    <Label MinWidth="240" Text="{Loc 'portable-generator-ui-fuel-left-label'}"/>
                    <Label Name="FuelLeft"/>
                    <ProgressBar Name="FuelFraction" MaxValue="1" MinWidth="60" HorizontalExpand="True"/>
                    <Button Name="FuelEject" Text="{Loc 'portable-generator-ui-eject'}"/>
                </BoxContainer>
                <BoxContainer Name="VoltageRow" Visible="False" SeparationOverride="8">
                    <Label Name="OutputSwitchLabel" MinWidth="240"/>
                    <Button Name="OutputSwitchButton" HorizontalExpand="True"/>
                </BoxContainer>
            </BoxContainer>

            <PanelContainer Name="OperatingPanel" Visible="False">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#161616" BorderColor="#505050" BorderThickness="1"/>
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="6">
                    <Label Name="OperatingCondition" StyleClasses="terminal-heading"/>
                    <Label Name="OperatingOutput"/>
                    <Label Name="OperatingTemperature"/>
                    <ProgressBar Name="TemperatureBar" MaxValue="1"/>
                    <Label Name="OperatingCooling" StyleClasses="terminal-muted"/>
                    <Label Name="OperatingDecay" StyleClasses="terminal-muted"/>
                    <Label Name="OperatingFields" StyleClasses="terminal-muted"/>
                    <Label Name="OperatingKinetics" Visible="False" StyleClasses="terminal-muted"/>
                    <Label Name="OperatingGravityHorizon" Visible="False" StyleClasses="terminal-muted"/>
                    <Label Name="FusionUtilities" Visible="False" StyleClasses="terminal-muted"/>
                    <ProgressBar Name="WarmupBar" MaxValue="1"/>
                    <Button Name="ResetButton" Text="{Loc 'power-plant-reset'}" HorizontalAlignment="Right"/>
                </BoxContainer>
            </PanelContainer>
            <Label Name="CloggedLabel" Visible="False" Text="{Loc 'portable-generator-ui-clogged'}" ClipText="True"/>
        </BoxContainer>
    </ScrollContainer>
</controls:ImmersiveFancyWindow>

<Control xmlns="https://spacestation14.io" xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client" MinWidth="280" HorizontalExpand="True" VerticalExpand="True">
    <BoxContainer Orientation="Vertical" Margin="16 4 8 8" SeparationOverride="10">
        <Label Text="{Loc 'industrial-research-dossier'}" StyleClasses="terminal-muted"/>
        <BoxContainer Name="InfoContainer" Orientation="Vertical" SeparationOverride="8">
            <BoxContainer SeparationOverride="10">
                <TextureRect Name="TechnologyTexture" SetSize="48 48" TextureScale="1.5 1.5" Stretch="KeepAspectCentered"/>
                <BoxContainer Orientation="Vertical" VerticalAlignment="Center" HorizontalExpand="True">
                    <Label Name="DisciplineLabel" StyleClasses="terminal-muted" ClipText="True"/>
                    <RichTextLabel Name="TechnologyCostLabel"/>
                </BoxContainer>
                <TextureRect Name="DisciplineTexture" Visible="False"/>
            </BoxContainer>
            <RichTextLabel Name="TechnologyNameLabel" StyleClasses="terminal-heading" HorizontalExpand="True"/>
            <Button Name="ResearchButton" Text="{Loc 'research-console-menu-server-research-button'}" HorizontalExpand="True" Margin="0 4"/>
        </BoxContainer>
        <PanelContainer MinHeight="1"><PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#505050"/></PanelContainer.PanelOverride></PanelContainer>
        <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="10" HorizontalExpand="True">
                <RichTextLabel Name="NoPrereqLabel" HorizontalExpand="True"/>
                <BoxContainer Name="PrereqsContainer" Orientation="Vertical" SeparationOverride="6" Visible="False">
                    <Label Text="{Loc 'research-console-required-text'}" StyleClasses="terminal-muted"/>
                    <BoxContainer Name="RequiredTechContainer" Orientation="Vertical" SeparationOverride="4"/>
                </BoxContainer>
                <BoxContainer Name="RecipesContainer" Orientation="Vertical" SeparationOverride="6">
                    <Label Text="{Loc 'research-console-unlocks-text'}" StyleClasses="terminal-muted"/>
                    <BoxContainer Name="UnlocksContainer" Orientation="Vertical" SeparationOverride="8"/>
                </BoxContainer>
                <BoxContainer Name="NextSection" Orientation="Vertical" SeparationOverride="6">
                    <Label Text="{Loc 'industrial-research-next'}" StyleClasses="terminal-muted"/>
                    <BoxContainer Name="NextTechContainer" Orientation="Vertical" SeparationOverride="4"/>
                </BoxContainer>
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</Control>

<cartridges:NanoTaskUiFragment xmlns:cartridges="clr-namespace:Content.Client.CartridgeLoader.Cartridges"
                              xmlns="https://spacestation14.io" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="5">
    <BoxContainer Orientation="Vertical" SetWidth="260" SeparationOverride="4">
        <BoxContainer SeparationOverride="4">
            <LineEdit Name="Search" HorizontalExpand="True" MinHeight="26" PlaceHolder="{Loc 'pda-tasks-search'}"/>
            <Button Name="NewTaskButton" Text="+" MinHeight="26" ToolTip="{Loc 'nano-task-ui-new-task'}" StyleClasses="pda-primary"/>
        </BoxContainer>
        <CheckBox Name="ShowDone" Text="{Loc 'pda-tasks-show-done'}" Pressed="True"/>
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="TaskList" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4"/>
        </ScrollContainer>
    </BoxContainer>
    <PanelContainer MinWidth="1" StyleClasses="pda-divider"/>
    <cartridges:NanoTaskItemEditor Name="Editor" Access="Public"/>
</cartridges:NanoTaskUiFragment>

<cartridges:NewsReaderUiFragment xmlns:cartridges="clr-namespace:Content.Client.CartridgeLoader.Cartridges" xmlns="https://spacestation14.io" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="4">
    <BoxContainer SeparationOverride="4">
        <Button Name="Prev" Text="‹" MinWidth="28" MinHeight="26" Disabled="True" ToolTip="{Loc 'news-read-ui-prev-tooltip'}" Access="Public"/>
        <Label Text="{Loc 'pda-news-heading'}" HorizontalExpand="True" StyleClasses="pda-caption"/>
        <Label Name="PageNum" StyleClasses="terminal-muted"/>
        <Button Name="Next" Text="›" MinWidth="28" MinHeight="26" Disabled="True" ToolTip="{Loc 'news-read-ui-next-tooltip'}"/>
    </BoxContainer>
    <PanelContainer Name="ArticleNameContainer" MinHeight="1" StyleClasses="pda-divider"/>
    <ScrollContainer Name="PageTextScroll" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
            <RichTextLabel Name="PageName" HorizontalExpand="True" StyleClasses="pda-title"/>
            <RichTextLabel Name="PageText" HorizontalExpand="True" Margin="0 3"/>
            <BoxContainer Name="PageTextContainer" Orientation="Vertical" HorizontalExpand="True"/>
        </BoxContainer>
    </ScrollContainer>
    <PanelContainer MinHeight="1" StyleClasses="pda-divider"/>
    <BoxContainer SeparationOverride="5">
        <Button Name="NotificationSwitch" MinHeight="24" ToolTip="{Loc 'news-reader-ui-mute-tooltip'}"/>
        <RichTextLabel Name="ShareTime" VerticalAlignment="Center"/>
        <Control HorizontalExpand="True"/>
    </BoxContainer>
    <RichTextLabel Name="Author" HorizontalExpand="True"/>
</cartridges:NewsReaderUiFragment>

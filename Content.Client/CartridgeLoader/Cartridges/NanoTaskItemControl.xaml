<Control xmlns="https://spacestation14.io" xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <BoxContainer Name="MainContainer"
                  Orientation="Horizontal"
                  HorizontalExpand="True" SeparationOverride="2">
        <Button Name="MainButton"
                HorizontalExpand="True"
                VerticalExpand="True"
                StyleClasses="button"
                Margin="0">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical"
                              VerticalExpand="True"
                              HorizontalExpand="True"
                              Margin="2">
                    <Label Name="TaskLabel"
                           ClipText="True" />
                    <Label Name="TaskForLabel"
                           StyleClasses="terminal-muted" ClipText="True"
                           Margin="0" />
                </BoxContainer>
            </BoxContainer>
        </Button>
        <Button Name="DoneButton"
                VerticalExpand="True"
                Text="{Loc 'nano-task-ui-done'}">
            <Button.StyleClasses>
                <system:String>ButtonSmall</system:String>
                <system:String>OpenLeft</system:String>
            </Button.StyleClasses>
        </Button>
    </BoxContainer>
</Control>

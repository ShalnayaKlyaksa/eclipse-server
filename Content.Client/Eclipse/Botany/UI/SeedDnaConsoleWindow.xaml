<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               MinSize="520 440" Title="{Loc 'seed-dna-window-title'}">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="10">
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Label Text="{Loc 'seed-dna-window-seed'}" />
            <Button Name="SeedButton" Access="Public" />
            <Label Name="SeedLabel" />
        </BoxContainer>
        <Button Name="DnaDiskButton" Access="Public" Visible="False" Text="{Loc 'seed-dna-legacy-disk-eject'}" />
        <Label Text="{Loc 'seed-dna-analysis-hint'}" />
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Name="Report" Orientation="Vertical" SeparationOverride="5" />
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>

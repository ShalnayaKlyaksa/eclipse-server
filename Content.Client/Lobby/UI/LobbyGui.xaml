<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:eclipse="clr-namespace:Content.Client.MainMenu.UI"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets">
    <TextureRect Access="Public"
                 Name="Background"
                 TexturePath="/Textures/Eclipse/MainMenu/eclipse_lobby_background.png"
                 Stretch="KeepAspectCovered"
                 VerticalExpand="True"
                 HorizontalExpand="True" />

    <!-- Second background layer, drawn over Background and faded in from transparent to cross-fade
         between wallpapers. Once a fade completes its texture is moved down to Background. -->
    <TextureRect Access="Public"
                 Name="BackgroundNext"
                 Visible="False"
                 Stretch="KeepAspectCovered"
                 VerticalExpand="True"
                 HorizontalExpand="True" />

    <PanelContainer VerticalExpand="True"
                    HorizontalExpand="True">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#07030091" />
        </PanelContainer.PanelOverride>
    </PanelContainer>

    <LayoutContainer Name="MainContainer"
                     VerticalExpand="True"
                     HorizontalExpand="True">
        <PanelContainer Name="LeftSide"
                        SetWidth="280"
                        RectClipContent="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#050200E8"
                                  BorderColor="#A85E124D"
                                  BorderThickness="0 0 1 0" />
            </PanelContainer.PanelOverride>
            <BoxContainer Name="SidebarColumn"
                          Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          Margin="32 30 24 32"
                          SeparationOverride="0">
                <BoxContainer Name="SidebarHeader"
                              Orientation="Horizontal"
                              SetHeight="80"
                              RectClipContent="True"
                              SeparationOverride="12">
                    <TextureRect Name="SidebarLogoIcon"
                                 TexturePath="/Textures/Logo/eclipse-icon.png"
                                 SetSize="64 64"
                                 Stretch="KeepAspectCentered"
                                 VerticalAlignment="Center" />
                    <!-- Thin gold accent rule between the mark and the wordmark. -->
                    <PanelContainer SetWidth="2"
                                    MinHeight="46"
                                    VerticalAlignment="Center">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#A85E1288" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>
                    <BoxContainer Orientation="Vertical"
                                  VerticalAlignment="Center"
                                  SeparationOverride="0">
                        <Label Text="ECLIPSE"
                               StyleIdentifier="mainMenuLogoTitle" />
                        <Label Text="STATION"
                               StyleIdentifier="mainMenuLogoSub" />
                    </BoxContainer>
                </BoxContainer>

                <Control Name="SidebarHeaderGap"
                         SetHeight="60" />

                <!-- The nav list is the only part of the sidebar that may lose space: a ScrollContainer measures as
                     zero, so the BoxContainer hands the character panel and the exit button their heights first and
                     gives the leftover here. ApplySidebarLayout shrinks the buttons long before this has to scroll. -->
                <ScrollContainer Name="NavScroll"
                                 VerticalExpand="True"
                                 HorizontalExpand="True"
                                 HScrollEnabled="False">
                    <BoxContainer Name="NavColumn"
                                  Orientation="Vertical"
                                  HorizontalExpand="True"
                                  SeparationOverride="0">

                        <Button Name="PlaySectionButton"
                                Access="Public"
                                HorizontalExpand="True"
                                MinHeight="86"
                                StyleIdentifier="mainMenuPrimary">
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          VerticalExpand="True"
                                          Margin="4 0 4 0"
                                          SeparationOverride="8">
                                <TextureRect Name="PlaySectionIcon"
                                             Access="Public"
                                             TexturePath="/Textures/Eclipse/MainMenu/icons/nav-play.png"
                                             SetSize="34 34"
                                             Stretch="KeepAspectCentered"
                                             ModulateSelfOverride="#E6A11A"
                                             VerticalAlignment="Center" />
                                <BoxContainer Orientation="Vertical"
                                              HorizontalExpand="True"
                                              VerticalAlignment="Center"
                                              SeparationOverride="6">
                                    <Label Name="PlaySectionTitle"
                                           Access="Public"
                                           Text="&#x0418;&#x0413;&#x0420;&#x0410;&#x0422;&#x042C;"
                                           StyleIdentifier="mainMenuNavTitle"
                                           ClipText="True" />
                                    <Label Name="PlaySectionSubtitle"
                                           Access="Public"
                                           Text="&#x041B;&#x043E;&#x0431;&#x0431;&#x0438; &#x0441;&#x0435;&#x0440;&#x0432;&#x0435;&#x0440;&#x0430;"
                                           StyleIdentifier="mainMenuNavSubtitle"
                                           ClipText="True" />
                                </BoxContainer>
                            </BoxContainer>
                        </Button>

                        <Control Name="NavGap1"
                                 SetHeight="14" />

                        <Button Name="StoreSectionButton"
                                Access="Public"
                                HorizontalExpand="True"
                                MinHeight="76"
                                StyleIdentifier="mainMenuNav">
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          VerticalExpand="True"
                                          Margin="4 0 4 0"
                                          SeparationOverride="8">
                                <TextureRect Name="StoreSectionIcon"
                                             Access="Public"
                                             TexturePath="/Textures/Eclipse/MainMenu/icons/nav-store.png"
                                             SetSize="34 34"
                                             Stretch="KeepAspectCentered"
                                             ModulateSelfOverride="#A6A6A6"
                                             VerticalAlignment="Center" />
                                <BoxContainer Orientation="Vertical"
                                              HorizontalExpand="True"
                                              VerticalAlignment="Center"
                                              SeparationOverride="5">
                                    <Label Name="StoreSectionTitle"
                                           Access="Public"
                                           Text="&#x041C;&#x0410;&#x0413;&#x0410;&#x0417;&#x0418;&#x041D;"
                                           StyleIdentifier="mainMenuNavTitle"
                                           ClipText="True" />
                                    <Label Name="StoreSectionSubtitle"
                                           Access="Public"
                                           Text="&#x0412;&#x0438;&#x0442;&#x0440;&#x0438;&#x043D;&#x044B;"
                                           StyleIdentifier="mainMenuNavSubtitle"
                                           ClipText="True" />
                                </BoxContainer>
                            </BoxContainer>
                        </Button>

                        <Control Name="NavGap2"
                                 SetHeight="14" />

                        <Button Name="AccountSectionButton"
                                Access="Public"
                                HorizontalExpand="True"
                                MinHeight="76"
                                StyleIdentifier="mainMenuNav">
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          VerticalExpand="True"
                                          Margin="4 0 4 0"
                                          SeparationOverride="8">
                                <TextureRect Name="AccountSectionIcon"
                                             Access="Public"
                                             TexturePath="/Textures/Eclipse/MainMenu/icons/nav-account.png"
                                             SetSize="34 34"
                                             Stretch="KeepAspectCentered"
                                             ModulateSelfOverride="#A6A6A6"
                                             VerticalAlignment="Center" />
                                <BoxContainer Orientation="Vertical"
                                              HorizontalExpand="True"
                                              VerticalAlignment="Center"
                                              SeparationOverride="5">
                                    <Label Name="AccountSectionTitle"
                                           Access="Public"
                                           Text="&#x0410;&#x041A;&#x041A;&#x0410;&#x0423;&#x041D;&#x0422;"
                                           StyleIdentifier="mainMenuNavTitle"
                                           ClipText="True" />
                                    <Label Name="AccountSectionSubtitle"
                                           Access="Public"
                                           Text="&#x041F;&#x0440;&#x043E;&#x0444;&#x0438;&#x043B;&#x044C; &#x0438;&#x0433;&#x0440;&#x043E;&#x043A;&#x0430;"
                                           StyleIdentifier="mainMenuNavSubtitle"
                                           ClipText="True" />
                                </BoxContainer>
                            </BoxContainer>
                        </Button>

                        <Control Name="NavGap3"
                                 SetHeight="14" />

                        <Button Name="SettingsSectionButton"
                                Access="Public"
                                HorizontalExpand="True"
                                MinHeight="76"
                                StyleIdentifier="mainMenuNav">
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          VerticalExpand="True"
                                          Margin="4 0 4 0"
                                          SeparationOverride="8">
                                <TextureRect Name="SettingsSectionIcon"
                                             Access="Public"
                                             TexturePath="/Textures/Interface/VerbIcons/settings.svg.192dpi.png"
                                             SetSize="34 34"
                                             Stretch="KeepAspectCentered"
                                             ModulateSelfOverride="#A6A6A6"
                                             VerticalAlignment="Center" />
                                <BoxContainer Orientation="Vertical"
                                              HorizontalExpand="True"
                                              VerticalAlignment="Center"
                                              SeparationOverride="5">
                                    <Label Name="SettingsSectionTitle"
                                           Access="Public"
                                           Text="&#x041D;&#x0410;&#x0421;&#x0422;&#x0420;&#x041E;&#x0419;&#x041A;&#x0418;"
                                           StyleIdentifier="mainMenuNavTitle"
                                           ClipText="True" />
                                    <Label Name="SettingsSectionSubtitle"
                                           Access="Public"
                                           Text="&#x0418;&#x043D;&#x0442;&#x0435;&#x0440;&#x0444;&#x0435;&#x0439;&#x0441;"
                                           StyleIdentifier="mainMenuNavSubtitle"
                                           ClipText="True" />
                                </BoxContainer>
                            </BoxContainer>
                        </Button>

                        <Control Name="NavGap4"
                                 SetHeight="14" />

                        <Button Name="RoadmapSectionButton"
                                Access="Public"
                                HorizontalExpand="True"
                                MinHeight="76"
                                StyleIdentifier="mainMenuNav">
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          VerticalExpand="True"
                                          Margin="4 0 4 0"
                                          SeparationOverride="8">
                                <TextureRect Name="RoadmapSectionIcon"
                                             Access="Public"
                                             TexturePath="/Textures/Eclipse/MainMenu/icons/nav-roadmap.png"
                                             SetSize="34 34"
                                             Stretch="KeepAspectCentered"
                                             ModulateSelfOverride="#A6A6A6"
                                             VerticalAlignment="Center" />
                                <BoxContainer Orientation="Vertical"
                                              HorizontalExpand="True"
                                              VerticalAlignment="Center"
                                              SeparationOverride="5">
                                    <Label Name="RoadmapSectionTitle"
                                           Access="Public"
                                           Text="ПЛАНЫ"
                                           StyleIdentifier="mainMenuNavTitle"
                                           ClipText="True" />
                                    <Label Name="RoadmapSectionSubtitle"
                                           Access="Public"
                                           Text="Дорожная карта"
                                           StyleIdentifier="mainMenuNavSubtitle"
                                           ClipText="True" />
                                </BoxContainer>
                            </BoxContainer>
                        </Button>

                        <Control Name="NavGap5"
                                 SetHeight="14" />

                        <Button Name="TutorialSectionButton"
                                Access="Public"
                                HorizontalExpand="True"
                                MinHeight="76"
                                StyleIdentifier="mainMenuNav">
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          VerticalExpand="True"
                                          Margin="4 0 4 0"
                                          SeparationOverride="8">
                                <TextureRect Name="TutorialSectionIcon"
                                             Access="Public"
                                             TexturePath="/Textures/Interface/VerbIcons/examine.svg.192dpi.png"
                                             SetSize="34 34"
                                             Stretch="KeepAspectCentered"
                                             ModulateSelfOverride="#A6A6A6"
                                             VerticalAlignment="Center" />
                                <BoxContainer Orientation="Vertical"
                                              HorizontalExpand="True"
                                              VerticalAlignment="Center"
                                              SeparationOverride="5">
                                    <Label Name="TutorialSectionTitle"
                                           Access="Public"
                                           Text="ОБУЧЕНИЕ"
                                           StyleIdentifier="mainMenuNavTitle"
                                           ClipText="True" />
                                    <Label Name="TutorialSectionSubtitle"
                                           Access="Public"
                                           Text="Уроки и туториалы"
                                           StyleIdentifier="mainMenuNavSubtitle"
                                           ClipText="True" />
                                </BoxContainer>
                            </BoxContainer>
                        </Button>

                    </BoxContainer>
                </ScrollContainer>

                <Control Name="SiteGapTop"
                         SetHeight="12" />

                <Button Name="SiteButton"
                        Access="Public"
                        HorizontalExpand="True"
                        MinHeight="76"
                        StyleIdentifier="mainMenuNav">
                    <BoxContainer Orientation="Horizontal"
                                  HorizontalExpand="True"
                                  VerticalExpand="True"
                                  Margin="4 0 4 0"
                                  SeparationOverride="8">
                        <TextureRect Name="SiteButtonIcon"
                                     Access="Public"
                                     TexturePath="/Textures/Logo/eclipse-icon.png"
                                     SetSize="34 34"
                                     Stretch="KeepAspectCentered"
                                     ModulateSelfOverride="#A6A6A6"
                                     VerticalAlignment="Center" />
                        <BoxContainer Orientation="Vertical"
                                      HorizontalExpand="True"
                                      VerticalAlignment="Center"
                                      SeparationOverride="5">
                            <Label Name="SiteButtonTitle"
                                   Access="Public"
                                   Text="&#x0421;&#x0410;&#x0419;&#x0422;"
                                   StyleIdentifier="mainMenuNavTitle"
                                   ClipText="True" />
                            <Label Name="SiteButtonSubtitle"
                                   Access="Public"
                                   Text="eclipse-station.online"
                                   StyleIdentifier="mainMenuNavSubtitle"
                                   ClipText="True" />
                        </BoxContainer>
                    </BoxContainer>
                </Button>

                <Control Name="SiteGap"
                         SetHeight="12" />

                <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview"
                                                    Access="Public"
                                                    HorizontalExpand="True"
                                                    SetHeight="278" />

                <Control Name="PreviewGap"
                         SetHeight="12" />

                <Button Name="LeaveButton"
                        Access="Public"
                        MinHeight="64"
                        StyleIdentifier="mainMenuFooter">
                    <BoxContainer Orientation="Horizontal"
                                  HorizontalExpand="True"
                                  VerticalExpand="True"
                                  SeparationOverride="13">
                        <TextureRect Name="LeaveButtonIcon"
                                     Access="Public"
                                     TexturePath="/Textures/Eclipse/MainMenu/icons/nav-exit.png"
                                     SetSize="30 30"
                                     Stretch="KeepAspectCentered"
                                     ModulateSelfOverride="#A6A6A6"
                                     VerticalAlignment="Center" />
                        <BoxContainer Orientation="Vertical"
                                      HorizontalExpand="True"
                                      VerticalAlignment="Center"
                                      SeparationOverride="4">
                            <Label Name="LeaveButtonTitle"
                                   Access="Public"
                                   Text="ВЫХОД"
                                   StyleIdentifier="mainMenuFooterTitle"
                                   ClipText="True" />
                            <Label Name="LeaveButtonSubtitle"
                                   Access="Public"
                                   Text="Покинуть лобби"
                                   StyleIdentifier="mainMenuNavSubtitle"
                                   ClipText="True" />
                        </BoxContainer>
                    </BoxContainer>
                </Button>
            </BoxContainer>
        </PanelContainer>

        <PanelContainer Name="TopStatusPanel"
                        SetSize="775 92"
                        RectClipContent="True">
            <PanelContainer.PanelOverride>
                <eclipse:EclipseStyleBoxRounded BackgroundColor="#070300F6"
                                                BorderColor="#A85E126A"
                                                BorderThickness="1"
                                                Radius="8" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Horizontal"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          Margin="16 9 10 9"
                          SeparationOverride="8">
                <PanelContainer SetSize="48 48">
                    <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#1A0900CC"
                                          BorderColor="#FFB63B77"
                                          BorderThickness="1" />
                    </PanelContainer.PanelOverride>
                    <TextureRect TexturePath="/Textures/Logo/eclipse-icon.png"
                                 Stretch="KeepAspectCentered"
                                 Margin="6 6 6 6" />
                </PanelContainer>

                <BoxContainer Name="AccountNameBlock"
                              Orientation="Vertical"
                              SetWidth="148"
                              VerticalAlignment="Center"
                              SeparationOverride="2">
                    <Label Name="AccountName"
                           Access="Public"
                           Text=""
                           StyleIdentifier="mainMenuText"
                           ClipText="True" />
                    <Label Name="AccountTitle"
                           Access="Public"
                           Text="&#x0418;&#x0433;&#x0440;&#x043E;&#x043A;"
                           StyleIdentifier="mainMenuTinySubtle"
                           ClipText="True" />
                </BoxContainer>

                <PanelContainer MinSize="1 0">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#A85E124C" />
                    </PanelContainer.PanelOverride>
                </PanelContainer>

                <BoxContainer Name="AccountRankBlock"
                              Orientation="Horizontal"
                              SetWidth="190"
                              VerticalAlignment="Center"
                              SeparationOverride="8">
                    <PanelContainer SetSize="34 34">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#1A0900CC"
                                              BorderColor="#D5C9AE66"
                                              BorderThickness="1" />
                        </PanelContainer.PanelOverride>
                        <Label Text="&#x25C8;"
                               StyleIdentifier="mainMenuRankIcon"
                               Align="Center"
                               VAlign="Center" />
                    </PanelContainer>
                    <BoxContainer Orientation="Vertical"
                                  SetWidth="142"
                                  SeparationOverride="1"
                                  VerticalAlignment="Center">
                        <Label Name="AccountRole"
                               Access="Public"
                               Text="&#x041A;&#x0430;&#x043F;&#x0438;&#x0442;&#x0430;&#x043D;"
                               StyleIdentifier="mainMenuText"
                               ClipText="True" />
                        <Label Name="AccountLevel"
                               Access="Public"
                               Text="&#x0423;&#x0440;&#x043E;&#x0432;&#x0435;&#x043D;&#x044C; 25"
                               StyleIdentifier="mainMenuSubtle"
                               ClipText="True" />
                        <Label Name="AccountExperience"
                               Access="Public"
                               Text="1372 / 1600 XP"
                               StyleIdentifier="mainMenuSubtle"
                               ClipText="True" />
                        <ProgressBar Name="AccountExperienceProgress"
                                     Access="Public"
                                     MinValue="0"
                                     MaxValue="1"
                                     Value="0.86"
                                     SetHeight="5"
                                     Margin="0 -1 0 0"
                                     HorizontalExpand="True"
                                     VerticalAlignment="Top" />
                    </BoxContainer>
                </BoxContainer>

                <PanelContainer MinSize="1 0">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#A85E124C" />
                    </PanelContainer.PanelOverride>
                </PanelContainer>

                <BoxContainer Name="AccountCurrencyBlock"
                              Orientation="Vertical"
                              SetWidth="132"
                              VerticalAlignment="Center"
                              SeparationOverride="5">
                    <BoxContainer Orientation="Horizontal"
                                  SetWidth="128"
                                  SeparationOverride="7">
                        <TextureRect TexturePath="/Textures/Eclipse/MainMenu/merit.png"
                                     SetSize="24 24"
                                     Stretch="KeepAspectCentered"
                                     VerticalAlignment="Center" />
                        <Label Name="MeritBalance"
                               Access="Public"
                               Text="12 450"
                               SetWidth="88"
                               StyleIdentifier="mainMenuText"
                               ClipText="True"
                               VAlign="Center" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal"
                                  SetWidth="128"
                                  SeparationOverride="7">
                        <TextureRect TexturePath="/Textures/Eclipse/MainMenu/shard.png"
                                     SetSize="28 28"
                                     Stretch="KeepAspectCentered"
                                     VerticalAlignment="Center" />
                        <Label Name="ShardBalance"
                               Access="Public"
                               Text="850"
                               SetWidth="88"
                               StyleIdentifier="mainMenuText"
                               ClipText="True"
                               VAlign="Center" />
                    </BoxContainer>
                </BoxContainer>

                <PanelContainer Name="LaunchDivider"
                                Access="Public"
                                MinSize="1 0">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#A85E124C" />
                    </PanelContainer.PanelOverride>
                </PanelContainer>

                <BoxContainer Name="LaunchStatus"
                              Access="Public"
                              Orientation="Vertical"
                              SetWidth="158"
                              VerticalAlignment="Center"
                              SeparationOverride="5">
                    <Label Text="&#x0414;&#x041E; &#x0417;&#x0410;&#x041F;&#x0423;&#x0421;&#x041A;&#x0410;"
                           StyleIdentifier="mainMenuGoldSmall"
                           ClipText="True" />
                    <Label Name="StartTime"
                           Access="Public"
                           StyleIdentifier="mainMenuScore"
                           ClipText="True"
                           VAlign="Center" />
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <PanelContainer Name="NewsPanel"
                        SetSize="350 350"
                        RectClipContent="True">
            <PanelContainer.PanelOverride>
                <eclipse:EclipseStyleBoxRounded BackgroundColor="#070300F2"
                                                BorderColor="#A85E126C"
                                                BorderThickness="1"
                                                Radius="8" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          Margin="16 15 16 15"
                          SeparationOverride="11">
                <BoxContainer Orientation="Horizontal"
                              SeparationOverride="8">
                    <Label Text="&#x041D;&#x041E;&#x0412;&#x041E;&#x0421;&#x0422;&#x0418;"
                           StyleIdentifier="mainMenuHeaderGold"
                           HorizontalExpand="True"
                           VAlign="Center" />
                    <!-- One dot per news entry, current one highlighted; populated in code. -->
                    <BoxContainer Name="NewsDots"
                                  Access="Public"
                                  Orientation="Horizontal"
                                  VerticalAlignment="Center"
                                  SeparationOverride="5" />
                </BoxContainer>
                <PanelContainer MinHeight="1">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#A85E1244" />
                    </PanelContainer.PanelOverride>
                </PanelContainer>

                <!-- The whole card is a button: clicking it opens the full article. Its contents cross-fade
                     between entries; NewsCardBody carries the fade alpha so the button chrome stays solid. -->
                <Button Name="NewsCard"
                        Access="Public"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        StyleIdentifier="mainMenuNav">
                    <BoxContainer Name="NewsCardBody"
                                  Access="Public"
                                  Orientation="Vertical"
                                  HorizontalExpand="True"
                                  VerticalExpand="True"
                                  Margin="10 10 10 8"
                                  SeparationOverride="7">
                        <PanelContainer SetHeight="132"
                                        HorizontalExpand="True"
                                        RectClipContent="True">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BackgroundColor="#08060333"
                                                  BorderColor="#A85E1255"
                                                  BorderThickness="1" />
                            </PanelContainer.PanelOverride>
                            <TextureRect Name="NewsImage"
                                         Access="Public"
                                         TexturePath="/Textures/Eclipse/MainMenu/news/news-tech.png"
                                         Stretch="KeepAspectCovered"
                                         VerticalExpand="True"
                                         HorizontalExpand="True" />
                        </PanelContainer>
                        <BoxContainer Orientation="Horizontal"
                                      HorizontalExpand="True"
                                      SeparationOverride="8">
                            <!-- Badge ("Важное!" / "Новость дня" / "Экстренное") is inserted here in code. -->
                            <BoxContainer Name="NewsBadgeSlot"
                                          Access="Public"
                                          Orientation="Horizontal"
                                          VerticalAlignment="Center" />
                            <Label Name="NewsDate"
                                   Access="Public"
                                   Text="18.05.2024"
                                   StyleIdentifier="mainMenuTinySubtle"
                                   HorizontalExpand="True"
                                   VerticalAlignment="Center" />
                        </BoxContainer>
                        <Label Name="NewsTitle"
                               Access="Public"
                               Text="&#x0422;&#x0435;&#x0445;&#x043D;&#x0438;&#x0447;&#x0435;&#x0441;&#x043A;&#x0438;&#x0435; &#x0440;&#x0430;&#x0431;&#x043E;&#x0442;&#x044B;"
                               StyleIdentifier="mainMenuHeaderGold"
                               ClipText="True" />
                        <Label Name="NewsText"
                               Access="Public"
                               Text="&#x0417;&#x0430;&#x0432;&#x0442;&#x0440;&#x0430; &#x0441; 09:00 &#x0434;&#x043E; 12:00 &#x043F;&#x043E; &#x041C;&#x0421;&#x041A; &#x0441;&#x0435;&#x0440;&#x0432;&#x0435;&#x0440; &#x0431;&#x0443;&#x0434;&#x0435;&#x0442; &#x043D;&#x0435;&#x0434;&#x043E;&#x0441;&#x0442;&#x0443;&#x043F;&#x0435;&#x043D;."
                               StyleIdentifier="mainMenuSubtle"
                               VerticalExpand="True"
                               ClipText="True" />
                        <Label Text="&#x0427;&#x0438;&#x0442;&#x0430;&#x0442;&#x044C; &#x043F;&#x043E;&#x043B;&#x043D;&#x043E;&#x0441;&#x0442;&#x044C;&#x044E; &#x2192;"
                               StyleIdentifier="mainMenuGoldSmall"
                               HorizontalAlignment="Right" />
                    </BoxContainer>
                </Button>
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Name="ServerActions"
                      Orientation="Horizontal"
                      SeparationOverride="10">
            <Button Name="VotesTabButton"
                    Access="Public"
                    SetWidth="170"
                    MinHeight="70"
                    StyleIdentifier="mainMenuSecondary">
                <Label Name="VotesTabLabel"
                       Access="Public"
                       Text="&#x0413;&#x041E;&#x041B;&#x041E;&#x0421;&#x041E;&#x0412;&#x0410;&#x041D;&#x0418;&#x042F;"
                       StyleIdentifier="mainMenuTabActive"
                       Align="Center"
                       VAlign="Center"
                       ClipText="True" />
            </Button>
            <!-- Clicking this opens ServerListPanel below it. The label is kept at the small gold size so
                 "СЕРВЕРЫ ECLIPSE" fits next to the votes button instead of being clipped. -->
            <Button Name="ServerSelectButton"
                    Access="Public"
                    HorizontalExpand="True"
                    MinHeight="70"
                    StyleIdentifier="mainMenuSecondary">
                <BoxContainer Orientation="Horizontal"
                              HorizontalExpand="True"
                              VerticalExpand="True"
                              Margin="12 0 10 0"
                              SeparationOverride="10">
                    <PanelContainer SetSize="30 30"
                                    VerticalAlignment="Center">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#1A0900CC"
                                              BorderColor="#F0A51377"
                                              BorderThickness="1" />
                        </PanelContainer.PanelOverride>
                        <Label Text="&#x2630;"
                               StyleIdentifier="mainMenuServerIcon"
                               Align="Center"
                               VAlign="Center" />
                    </PanelContainer>
                    <BoxContainer Orientation="Vertical"
                                  HorizontalExpand="True"
                                  VerticalAlignment="Center"
                                  SeparationOverride="3">
                        <!-- Short label on purpose: the full "СЕРВЕРЫ ECLIPSE" does not fit next to the votes
                             button on narrow windows and was being clipped. -->

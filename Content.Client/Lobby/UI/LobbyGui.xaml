                                    <BoxContainer Name="SiteLatestNews"
                                                  Access="Public"
                                                  Orientation="Vertical"
                                                  HorizontalExpand="True"
                                                  SeparationOverride="0" />
                                </ScrollContainer>
                                <Button Name="SiteExternalButton"
                                        Access="Public"
                                        HorizontalExpand="True"
                                        MinHeight="34"
                                        StyleIdentifier="mainMenuSecondary">
                                    <Label Text="&#x041E;&#x0442;&#x043A;&#x0440;&#x044B;&#x0442;&#x044C; &#x0432; &#x0431;&#x0440;&#x0430;&#x0443;&#x0437;&#x0435;&#x0440;&#x0435;"
                                           StyleIdentifier="mainMenuSecondaryTitle"
                                           Align="Center"
                                           VAlign="Center"
                                           ClipText="True" />
                                </Button>
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>

                <!-- Account page: character doll on the left, progression / stats / achievements on the right.
                     The stat cards, role list and achievement grid are built in code. -->
                <BoxContainer Name="AccountContent"
                              Access="Public"
                              Visible="False"
                              Orientation="Horizontal"
                              HorizontalExpand="True"
                              VerticalExpand="True"
                              SeparationOverride="16">
                    <PanelContainer SetWidth="300"
                                    VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <eclipse:EclipseStyleBoxRounded BackgroundColor="#070300F4"
                                                            BorderColor="#A85E1280"
                                                            BorderThickness="1"
                                                            Radius="8" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical"
                                      HorizontalExpand="True"
                                      VerticalExpand="True"
                                      Margin="14 12 14 12"
                                      SeparationOverride="10">
                            <Label Text="&#x041F;&#x0415;&#x0420;&#x0421;&#x041E;&#x041D;&#x0410;&#x0416;"
                                   StyleIdentifier="mainMenuHeaderGold"
                                   ClipText="True" />
                            <PanelContainer MinHeight="1">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#A85E123F" />
                                </PanelContainer.PanelOverride>
                            </PanelContainer>

                            <PanelContainer HorizontalExpand="True"
                                            VerticalExpand="True"
                                            RectClipContent="True">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#050200A8"
                                                      BorderColor="#2C221A66"
                                                      BorderThickness="1" />
                                </PanelContainer.PanelOverride>
                                <BoxContainer Orientation="Horizontal"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                    <profile:ProfilePreviewSpriteView Name="AccountPreviewSprite"
                                                                      Access="Public"
                                                                      OverrideDirection="South"
                                                                      Scale="5 5"
                                                                      MaxSize="240 240"
                                                                      Stretch="Fill" />
                                </BoxContainer>
                            </PanelContainer>

                            <Label Name="AccountCharacterName"
                                   Access="Public"
                                   StyleIdentifier="mainMenuText"
                                   Align="Center"
                                   ClipText="True" />
                            <Label Name="AccountCharacterAge"
                                   Access="Public"
                                   StyleIdentifier="mainMenuTinySubtle"
                                   Align="Center"
                                   ClipText="True" />
                            <Button Name="AccountCustomizeButton"
                                    Access="Public"
                                    HorizontalExpand="True"
                                    MinHeight="42"
                                    StyleIdentifier="mainMenuPrimary">
                                <Label Text="&#x041A;&#x0430;&#x0441;&#x0442;&#x043E;&#x043C;&#x0438;&#x0437;&#x0430;&#x0446;&#x0438;&#x044F;"
                                       StyleIdentifier="mainMenuSecondaryTitle"
                                       Align="Center"
                                       VAlign="Center"
                                       ClipText="True" />
                            </Button>
                        </BoxContainer>
                    </PanelContainer>

                    <BoxContainer Orientation="Vertical"
                                  HorizontalExpand="True"
                                  VerticalExpand="True"
                                  SeparationOverride="14">
                        <!-- Account level / rank -->
                        <PanelContainer HorizontalExpand="True">
                            <PanelContainer.PanelOverride>
                                <eclipse:EclipseStyleBoxRounded BackgroundColor="#070300F4"
                                                                BorderColor="#A85E1280"
                                                                BorderThickness="1"
                                                                Radius="8" />
                            </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical"
                                          HorizontalExpand="True"
                                          Margin="16 12 16 12"
                                          SeparationOverride="7">
                                <BoxContainer Orientation="Horizontal"
                                              HorizontalExpand="True"
                                              SeparationOverride="10">
                                    <BoxContainer Orientation="Vertical"
                                                  HorizontalExpand="True"
                                                  SeparationOverride="3">
                                        <Label Name="AccountPageName"
                                               Access="Public"
                                               StyleIdentifier="mainMenuHeaderGold"
                                               ClipText="True" />
                                        <Label Name="AccountPageRank"
                                               Access="Public"
                                               StyleIdentifier="mainMenuSubtle"
                                               ClipText="True" />
                                    </BoxContainer>
                                    <Label Name="AccountPageLevel"
                                           Access="Public"
                                           StyleIdentifier="mainMenuScore"
                                           VAlign="Center" />
                                </BoxContainer>
                                <ProgressBar Name="AccountPageXpBar"
                                             Access="Public"
                                             MinValue="0"
                                             MaxValue="1"
                                             Value="0"
                                             SetHeight="8"
                                             HorizontalExpand="True" />
                                <Label Name="AccountPageXpText"
                                       Access="Public"
                                       StyleIdentifier="mainMenuTinySubtle"
                                       ClipText="True" />
                            </BoxContainer>
                        </PanelContainer>

                        <!-- Stat cards, built in code -->
                        <BoxContainer Name="AccountStats"
                                      Access="Public"
                                      Orientation="Horizontal"
                                      HorizontalExpand="True"
                                      SeparationOverride="12" />

                        <BoxContainer Orientation="Horizontal"
                                      HorizontalExpand="True"
                                      SeparationOverride="8">
                            <Label Text="&#x041B;&#x042E;&#x0411;&#x0418;&#x041C;&#x042B;&#x0415; &#x0420;&#x041E;&#x041B;&#x0418;"
                                   StyleIdentifier="mainMenuCompactHeaderGold"
                                   HorizontalExpand="True"
                                   VAlign="Center" />
                        </BoxContainer>
                        <BoxContainer Name="AccountTopRoles"
                                      Access="Public"
                                      Orientation="Vertical"
                                      HorizontalExpand="True"
                                      SeparationOverride="6" />

                        <BoxContainer Orientation="Horizontal"
                                      HorizontalExpand="True"
                                      SeparationOverride="8">
                            <Label Text="&#x0414;&#x041E;&#x0421;&#x0422;&#x0418;&#x0416;&#x0415;&#x041D;&#x0418;&#x042F;"
                                   StyleIdentifier="mainMenuCompactHeaderGold"
                                   HorizontalExpand="True"
                                   VAlign="Center" />
                            <Label Name="AccountAchievementsCount"
                                   Access="Public"
                                   StyleIdentifier="mainMenuGoldSmall"
                                   VAlign="Center" />
                        </BoxContainer>
                        <ScrollContainer HorizontalExpand="True"
                                         VerticalExpand="True"
                                         HScrollEnabled="False">
                            <GridContainer Name="AccountAchievements"
                                           Access="Public"
                                           Columns="2"
                                           HorizontalExpand="True"
                                           HSeparationOverride="10"
                                           VSeparationOverride="10" />
                        </ScrollContainer>
                    </BoxContainer>
                </BoxContainer>

                <!-- Full-screen settings: a column of section buttons on the left, the selected options tab on
                     the right. The tabs themselves are the stock Content.Client.Options ones, reused as-is. -->
                <BoxContainer Name="SettingsContent"
                              Access="Public"
                              Visible="False"
                              Orientation="Horizontal"
                              HorizontalExpand="True"
                              VerticalExpand="True"
                              SeparationOverride="16">
                    <PanelContainer SetWidth="252"
                                    VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <eclipse:EclipseStyleBoxRounded BackgroundColor="#070300F4"
                                                            BorderColor="#A85E1280"
                                                            BorderThickness="1"
                                                            Radius="8" />
                        </PanelContainer.PanelOverride>
                        <ScrollContainer HorizontalExpand="True"
                                         VerticalExpand="True"
                                         HScrollEnabled="False"
                                         Margin="10 10 10 10">
                            <BoxContainer Name="SettingsTabButtons"
                                          Access="Public"
                                          Orientation="Vertical"
                                          HorizontalExpand="True"
                                          SeparationOverride="6" />
                        </ScrollContainer>
                    </PanelContainer>

                    <PanelContainer HorizontalExpand="True"
                                    VerticalExpand="True"
                                    RectClipContent="True">
                        <PanelContainer.PanelOverride>
                            <eclipse:EclipseStyleBoxRounded BackgroundColor="#070300F4"
                                                            BorderColor="#A85E1280"
                                                            BorderThickness="1"
                                                            Radius="8" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical"
                                      HorizontalExpand="True"
                                      VerticalExpand="True"
                                      Margin="14 12 14 12"
                                      SeparationOverride="10">
                            <Label Name="SettingsTabTitle"
                                   Access="Public"
                                   Text="&#x041E;&#x0431;&#x0449;&#x0438;&#x0435;"
                                   StyleIdentifier="mainMenuHeaderGold"
                                   ClipText="True" />
                            <PanelContainer MinHeight="1">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#A85E123F" />
                                </PanelContainer.PanelOverride>
                            </PanelContainer>
                            <BoxContainer Name="SettingsTabContent"
                                          Access="Public"
                                          Orientation="Vertical"
                                          HorizontalExpand="True"
                                          VerticalExpand="True" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>

                <Control Name="SectionFiller"
                         Access="Public"
                         VerticalExpand="True" />
            </BoxContainer>
        </PanelContainer>

        <cc:UICommandButton Command="observe"
                            Name="ObserveButton"
                            Access="Public"
                            Visible="False"
                            Text="{Loc 'ui-lobby-observe-button'}"
                            WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
        <Button Name="AHelpButton"
                Access="Public"
                Visible="False"
                Text="{Loc 'ui-lobby-ahelp-button'}" />
        <vote:VoteCallMenuButton Name="CallVoteButton"
                                 Visible="False" />
        <BoxContainer Name="VoteContainer"
                      Access="Public"
                      Orientation="Vertical"
                      SeparationOverride="4"
                      HorizontalExpand="True" />
        <Control Name="DefaultState"
                 Access="Public"
                 Visible="True" />
        <Control Access="Public"
                 Visible="False"
                 Name="CharacterSetupState"
                 VerticalExpand="True"
                 HorizontalExpand="True" />
        <PanelContainer Name="ExpandPanel"
                        Visible="False">
            <TextureButton Name="ExpandButton"
                           TexturePath="filled_left_arrow.svg.192dpi" />
        </PanelContainer>
        <TextureButton Name="CollapseButton"
                       Visible="False"
                       TexturePath="filled_right_arrow.svg.192dpi" />
        <info:LinkBanner Name="LinkBanner"
                         Visible="False" />
        <info:DevInfoBanner Name="DevInfoBanner"
                            Visible="False" />
        <RichTextLabel Name="LobbySong"
                       Access="Public"
                       Visible="False" />
        <RichTextLabel Name="LobbyBackground"
                       Access="Public"
                       Visible="False" />
        <!-- Server picker dropdown, positioned under ServerSelectButton in ApplyEclipseLayout. -->
        <PanelContainer Name="ServerListPanel"
                        Access="Public"
                        Visible="False"
                        RectClipContent="True">
            <PanelContainer.PanelOverride>
                <eclipse:EclipseStyleBoxRounded BackgroundColor="#0A0400FA"
                                                BorderColor="#F0A51399"
                                                BorderThickness="1"
                                                Radius="8" />
            </PanelContainer.PanelOverride>
            <BoxContainer Name="ServerListContainer"
                          Access="Public"
                          Orientation="Vertical"
                          HorizontalExpand="True"
                          Margin="10 10 10 10"
                          SeparationOverride="6" />
        </PanelContainer>

    </LayoutContainer>
</lobbyUi:LobbyGui>
